# Snapgram – Umgebungsvariablen
#
# Welches Backend die App nutzt, wird beim Build automatisch entschieden (vite.config.ts):
#   npm run dev              -> eigenes Backend mit lokaler Datenbank (PGlite), ohne Setup
#   DATABASE_URL gesetzt     -> eigenes Backend (/api + Neon Postgres)   <- Live-Demo auf Vercel
#   Appwrite-Werte gesetzt   -> Appwrite, wie im Tutorial
#   nichts gesetzt           -> Offline-Demo, alles nur im Browser (localStorage)
#
# Lokal: diese Datei nach ".env.local" kopieren und nur ausfüllen, was du brauchst.

# ---------------- Eigenes Backend (Vercel Functions + Neon Postgres)

# Verbindung zur Neon-Datenbank. Wird von der Neon-Integration in Vercel
# automatisch gesetzt. GEHEIM: nie committen, nie mit VITE_ beginnen lassen.
DATABASE_URL=

# Alle wie viele Stunden die Demo-Daten zurückgesetzt werden (Standard: 24, 0 = nie)
DEMO_RESET_HOURS=

# Optional: Backend erzwingen (api | appwrite | demo)
VITE_BACKEND=

# ---------------- Appwrite (optional, wie im Original-Tutorial)
# Alles mit VITE_ landet im Browser-Code und ist öffentlich sichtbar.
# Niemals einen Appwrite-API-Key hier eintragen.

# Endpoint, z.B. https://fra.cloud.appwrite.io/v1 (steht in der Konsole unter Settings)
VITE_APPWRITE_URL=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_STORAGE_ID=
VITE_APPWRITE_USER_COLLECTION_ID=
VITE_APPWRITE_POST_COLLECTION_ID=
VITE_APPWRITE_SAVES_COLLECTION_ID=
